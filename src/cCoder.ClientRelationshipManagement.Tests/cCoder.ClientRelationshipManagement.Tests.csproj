<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>cCoder.ClientRelationshipManagement.Tests</AssemblyName>
    <RootNamespace>cCoder.ClientRelationshipManagement.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cCoder.CodeAnalysis" Version="2026.10.8.1211">
