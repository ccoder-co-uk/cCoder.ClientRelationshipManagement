<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <NoWarn>1591</NoWarn>
    <PackageId>cCoder.ClientRelationshipManagement.Runtime</PackageId>
    <PackageTags>cCoder;CRM;ClientRelationshipManagement;Runtime</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ProjectUrl>https://github.com/ccoder-co-uk/cCoder.ClientRelationshipManagement</ProjectUrl>
    <RepositoryUrl>https://github.com/ccoder-co-uk/cCoder.ClientRelationshipManagement.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Reusable CRM application runtime, bootstrap lifecycle, and optional hosted workflows.</Description>
    <Authors>cCoder</Authors>
    <Copyright>2026 Paul Ward</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cCoder.AI" Version="2026.8.1.1210" />
    <PackageReference Include="cCoder.CodeAnalysis" Version="2026.8.1.1211" />
    <PackageReference Include="cCoder.Security" Version="2026.7.30.2059" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\cCoder.ClientRelationshipManagement\cCoder.ClientRelationshipManagement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ClientRelationshipManagement.Web\Brokers\**\*.cs" Link="Brokers\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ClientRelationshipManagement.Web\Configuration\**\*.cs" Link="Configuration\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ClientRelationshipManagement.Web\IServiceCollectionExtensions.cs" Link="IServiceCollectionExtensions.cs" />
    <Compile Include="..\ClientRelationshipManagement.Web\Models\Admin\**\*.cs" Link="Models\Admin\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ClientRelationshipManagement.Web\Models\Imports\**\*.cs" Link="Models\Imports\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ClientRelationshipManagement.Web\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ClientRelationshipManagement.Web\Utilities\**\*.cs" Link="Utilities\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
