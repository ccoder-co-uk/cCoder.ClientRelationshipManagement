@using cCoder.ClientRelationshipManagement.Platform.Models.Enums
@using ClientRelationshipManagement.Web.Services.Processes
@model WorkflowModelPageViewModel
@{
    ViewData["Title"] = "Full Company Process Model";
    const int nodeStartLeft = 86;
    const int nodeColumnWidth = 250;
    const int portalColumnInset = 0;
    const int topRowOffset = 84;
    const int nodeRowSpacing = 240;
    const int nodeHeight = 144;
    Dictionary<Guid, int> portalColumns = [];
    Dictionary<Guid, Dictionary<Guid, (int Row, int Column)>> processStepLayouts = [];
    Dictionary<Guid, Dictionary<string, (int Row, int Column)>> processTerminalLayouts = [];
    Dictionary<Guid, int> processLaneTops = [];
    Dictionary<Guid, int> processLaneHeights = [];
    int nextLaneTop = 24;
    int maximumUsedColumn = 0;

    if (Model.Processes.Count > 0)
        portalColumns[Model.Processes[0].Id] = 0;

    foreach (WorkflowProcessViewModel process in Model.Processes)
    {
        int portalColumn = portalColumns.GetValueOrDefault(process.Id, 0);
        Dictionary<Guid, WorkflowStepViewModel> stepsById = process.Steps.ToDictionary(step => step.Id);
        Dictionary<Guid, int> depths = process.Steps.ToDictionary(step => step.Id, _ => -1);
        Queue<WorkflowStepViewModel> pendingSteps = new(process.Steps
            .Where(step => step.IsEntryPoint)
            .OrderBy(step => step.Sequence));

        if (pendingSteps.Count == 0 && process.Steps.Count > 0)
            pendingSteps.Enqueue(process.Steps.OrderBy(step => step.Sequence).First());

        foreach (WorkflowStepViewModel entryStep in pendingSteps)
            depths[entryStep.Id] = 0;

        // A column represents a genuine next-step generation. Sequential work
        // therefore stays on one horizontal stroke; only parallel next steps
        // claim additional rows in the same generation.
        while (pendingSteps.Count > 0)
        {
            WorkflowStepViewModel step = pendingSteps.Dequeue();
            int nextDepth = depths[step.Id] + 1;
            foreach (Guid nextStepId in step.Transitions
                .Where(transition => transition.NextProcessStepId.HasValue)
                .Select(transition => transition.NextProcessStepId!.Value)
                .Where(stepsById.ContainsKey)
                // A backwards route is an iteration, not a new layout level.
                .Where(nextStepId => stepsById[nextStepId].Sequence > step.Sequence))
            {
                if (depths[nextStepId] >= nextDepth)
                    continue;

                depths[nextStepId] = nextDepth;
                pendingSteps.Enqueue(stepsById[nextStepId]);
            }
        }

        int nextUnplacedDepth = depths.Values.Where(depth => depth >= 0).DefaultIfEmpty(-1).Max() + 1;
        foreach (WorkflowStepViewModel step in process.Steps.Where(step => depths[step.Id] < 0).OrderBy(step => step.Sequence))
            depths[step.Id] = nextUnplacedDepth++;

        int maximumDepth = depths.Values.DefaultIfEmpty(0).Max();
        // The turn point is a physical canvas boundary, not an arbitrary number
        // of steps. A generation advances to the available edge, drops one row,
        // then reverses. Parallel next steps stack inside the same generation.
        const int layoutColumnBudget = 6;
        int direction = portalColumn >= layoutColumnBudget / 2 ? -1 : 1;
        int firstBoundary = direction > 0 ? layoutColumnBudget : 0;
        int firstRowCapacity = Math.Abs(firstBoundary - portalColumn);
        if (firstRowCapacity == 0)
        {
            direction *= -1;
            firstBoundary = direction > 0 ? layoutColumnBudget : 0;
            firstRowCapacity = Math.Abs(firstBoundary - portalColumn);
        }
        int fullRowCapacity = layoutColumnBudget + 1;
        Func<int, (int Row, int Column)> snakePosition = depth =>
        {
            if (depth < firstRowCapacity)
                return (0, portalColumn + (direction * (depth + 1)));

            int remainingDepth = depth - firstRowCapacity;
            int row = 1 + (remainingDepth / fullRowCapacity);
            int offset = remainingDepth % fullRowCapacity;
            bool travelsBack = row % 2 == 1;
            int column = direction > 0
                ? travelsBack ? layoutColumnBudget - offset : offset
                : travelsBack ? offset : layoutColumnBudget - offset;
            return (row, column);
        };
        int branchBandHeight = Math.Max(1, process.Steps
            .GroupBy(step => depths[step.Id])
            .Select(group => group.Count())
            .DefaultIfEmpty(1)
            .Max());
        Dictionary<Guid, (int Row, int Column)> layout = [];
        foreach (IGrouping<int, WorkflowStepViewModel> generation in process.Steps
            .GroupBy(step => depths[step.Id])
            .OrderBy(group => group.Key))
        {
            (int snakeRow, int column) = snakePosition(generation.Key);
            int row = snakeRow * branchBandHeight;
            foreach (WorkflowStepViewModel step in generation.OrderBy(step => step.Sequence))
                layout[step.Id] = (row++, column);
        }

        Dictionary<string, (int Row, int Column)> terminalLayout = [];
        (int terminalSnakeRow, int terminalColumn) = snakePosition(maximumDepth + 1);
        int terminalRow = terminalSnakeRow * branchBandHeight;
        foreach (WorkflowTerminalNodeViewModel terminal in process.TerminalNodes
            .OrderBy(node => node.SourceStepIds
                .Where(layout.ContainsKey)
                .Select(id => layout[id].Row)
                .DefaultIfEmpty(0)
                .Average())
            .ThenBy(node => node.Name))
        {
            terminalLayout[terminal.GraphTargetId] = (terminalRow++, terminalColumn);
        }

        int maximumRow = Math.Max(
            layout.Values.Select(position => position.Row).DefaultIfEmpty(0).Max(),
            terminalLayout.Values.Select(position => position.Row).DefaultIfEmpty(0).Max());
        int laneHeight = topRowOffset + (maximumRow * nodeRowSpacing) + nodeHeight + 86;
        processStepLayouts[process.Id] = layout;
        processTerminalLayouts[process.Id] = terminalLayout;
        processLaneTops[process.Id] = nextLaneTop;
        processLaneHeights[process.Id] = laneHeight;
        nextLaneTop += laneHeight + 20;
        maximumUsedColumn = Math.Max(maximumUsedColumn, new[]
        {
            portalColumn,
            layout.Values.Select(position => position.Column).DefaultIfEmpty(portalColumn).Max(),
            terminalLayout.Values.Select(position => position.Column).DefaultIfEmpty(portalColumn).Max()
        }.Max());

        foreach (WorkflowStepViewModel step in process.Steps)
        {
            foreach (WorkflowTransitionViewModel transition in step.Transitions.Where(transition => transition.GraphTargetId.StartsWith("portal-", StringComparison.Ordinal)))
            {
                WorkflowProcessViewModel target = Model.Processes.FirstOrDefault(candidate =>
                    transition.GraphTargetId == $"portal-{candidate.Id:N}");
                if (target is not null)
                    portalColumns[target.Id] = layout[step.Id].Column;
            }
        }
    }

    int stageWidth = Math.Max(1540, nodeStartLeft + (maximumUsedColumn * nodeColumnWidth) + 240);
    int stageHeight = Math.Max(620, nextLaneTop + 6);
}

<main class="page-shell workflow-model-page">
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="notice-banner">@Model.Notice</div>
    }
    <section class="page-hero workflow-model-hero">
        <h1>Full Company Process Model</h1>
        <div class="page-hero__actions">
            <a class="secondary-action" href="/Admin/Process/Designer">Edit process layout</a>
            <a class="secondary-action" href="/Admin/Process">Process definitions</a>
        </div>
        <p class="lede">Trace every route from a company entering the work pool through lead qualification, opportunity conversion, and ongoing client care.</p>
    </section>

    <section class="workflow-model-status @(Model.IsValid && Model.CompanyCoverage.IsComplete ? "is-valid" : "has-errors")" aria-label="Workflow status">
        <div class="workflow-model-status__state">
            <span class="workflow-model-status__indicator" aria-hidden="true"></span>
            <div>
                <strong>@(Model.IsValid ? "Lifecycle is executable" : "Lifecycle needs attention")</strong>
                <small data-live-key="generated-at">Generated from the live process definitions at @Model.GeneratedOn.ToLocalTime().ToString("HH:mm:ss")</small>
            </div>
        </div>
        <div class="workflow-model-status__coverage" data-live-key="company-coverage">
            <strong>@Model.CompanyCoverage.AccountedCompanies.ToString("N0") of @Model.CompanyCoverage.TotalCompanies.ToString("N0") companies have a visible place</strong>
            <div>
                <span class="is-pool">Pool <b>@Model.CompanyCoverage.CandidateCompanies.ToString("N0")</b></span>
                <span class="is-lead">Leads <b>@Model.CompanyCoverage.LeadCompanies.ToString("N0")</b></span>
                <span class="is-opportunity">Opportunities <b>@Model.CompanyCoverage.OpportunityCompanies.ToString("N0")</b></span>
                <span class="is-client">Clients <b>@Model.CompanyCoverage.ClientCompanies.ToString("N0")</b></span>
                <span class="is-excluded">Excluded <b>@Model.CompanyCoverage.ExcludedCompanies.ToString("N0")</b></span>
                @if (Model.CompanyCoverage.ManualRelationshipCompanies > 0)
                {
                    <span class="is-manual">Manual relationships <b>@Model.CompanyCoverage.ManualRelationshipCompanies.ToString("N0")</b></span>
                }
                @if (Model.CompanyCoverage.UnclassifiedCompanies > 0)
                {
                    <span class="is-unclassified">Needs reconciliation <b>@Model.CompanyCoverage.UnclassifiedCompanies.ToString("N0")</b></span>
                }
            </div>
        </div>
        <dl>
            <div><dt>Processes</dt><dd>@Model.Processes.Count</dd></div>
            <div><dt>Steps</dt><dd>@Model.TotalSteps</dd></div>
            <div><dt>Routes</dt><dd>@Model.TotalTransitions</dd></div>
            <div><dt>Issues</dt><dd>@Model.Issues.Count</dd></div>
        </dl>
    </section>

    @if (Model.Issues.Count > 0)
    {
        <details class="workflow-model-findings">
            <summary>Review @Model.Issues.Count validation finding@(Model.Issues.Count == 1 ? "" : "s")</summary>
            <div>
                @foreach (ProcessValidationIssue issue in Model.Issues)
                {
                    <p><strong>@issue.ProcessName</strong>@(string.IsNullOrWhiteSpace(issue.StepName) ? "" : $" · {issue.StepName}") — @issue.Message</p>
                }
            </div>
        </details>
    }

    <section class="workflow-workspace" aria-label="Interactive company lifecycle design surface">
        <header class="workflow-workspace__toolbar">
            <div class="workflow-workspace__view-switcher" role="group" aria-label="Focus workflow lane">
                <button type="button" class="is-active" data-focus-lane="all">End to end</button>
                @foreach (WorkflowProcessViewModel process in Model.Processes)
                {
                    <button type="button" data-focus-lane="@process.Id">@process.LaneLabel</button>
                }
            </div>
            <div class="workflow-workspace__tools">
                <label class="workflow-auto-refresh">
                    <input type="checkbox" data-workflow-auto-refresh checked />
                    <span aria-hidden="true"></span>
                    Auto-refresh
                </label>
                <small class="workflow-refresh-status" id="workflowRefreshStatus">Updated @Model.GeneratedOn.ToLocalTime().ToString("HH:mm:ss")</small>
                <details class="workflow-legend">
                    <summary>Legend</summary>
                    <div>
                        <span><i class="is-default"></i> Default route</span>
                        <span><i class="is-branch"></i> Alternative outcome</span>
                        <span><i class="is-handoff"></i> Process hand-off</span>
                        <span><i class="is-terminal"></i> Lifecycle exit</span>
                        <span><i class="is-iteration" aria-hidden="true">↻</i> Repeating step</span>
                    </div>
                </details>
                <button type="button" data-workflow-zoom="out" title="Zoom out" aria-label="Zoom out">−</button>
                <output id="workflowZoom" aria-live="polite">100%</output>
                <button type="button" data-workflow-zoom="in" title="Zoom in" aria-label="Zoom in">+</button>
                <button type="button" data-workflow-fit>Fit</button>
            </div>
        </header>

        <div class="workflow-workspace__body">
            <div class="workflow-surface-viewport" id="workflowViewport" tabindex="0" aria-label="Workflow canvas. Drag the background to pan and use the toolbar to zoom.">
                <div class="workflow-surface-space" id="workflowSpace">
                    <div class="workflow-surface-stage" id="workflowStage" style="width:@(stageWidth)px;height:@(stageHeight)px" data-width="@stageWidth" data-height="@stageHeight" data-layout="topology-aware" data-terminal-column-reserved="true">
                        <svg class="workflow-connectors" id="workflowConnectors" width="@stageWidth" height="@stageHeight" aria-hidden="true">
                            <defs>
                                <marker id="workflowArrowDefault" viewBox="0 0 16 12" refX="1" refY="6" markerWidth="16" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto"><line x1="1" y1="6" x2="5" y2="6"></line><path d="M 5 1 L 15 6 L 5 11 z"></path></marker>
                                <marker id="workflowArrowBranch" viewBox="0 0 16 12" refX="1" refY="6" markerWidth="16" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto"><line x1="1" y1="6" x2="5" y2="6"></line><path d="M 5 1 L 15 6 L 5 11 z"></path></marker>
                                <marker id="workflowArrowHandoff" viewBox="0 0 16 12" refX="1" refY="6" markerWidth="16" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto"><line x1="1" y1="6" x2="5" y2="6"></line><path d="M 5 1 L 15 6 L 5 11 z"></path></marker>
                                <marker id="workflowArrowTerminal" viewBox="0 0 16 12" refX="1" refY="6" markerWidth="16" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto"><line x1="1" y1="6" x2="5" y2="6"></line><path d="M 5 1 L 15 6 L 5 11 z"></path></marker>
                            </defs>
                        </svg>

                        @for (int processIndex = 0; processIndex < Model.Processes.Count; processIndex++)
                        {
                            WorkflowProcessViewModel process = Model.Processes[processIndex];
                            int laneTop = processLaneTops[process.Id];
                            int laneHeight = processLaneHeights[process.Id];
                            int portalColumn = portalColumns.GetValueOrDefault(process.Id, 0);
                            Dictionary<Guid, (int Row, int Column)> stepLayout = processStepLayouts[process.Id];
                            Dictionary<string, (int Row, int Column)> terminalLayout = processTerminalLayouts[process.Id];
                            WorkflowStepViewModel entryStep = process.Steps
                                .OrderByDescending(step => step.IsEntryPoint)
                                .ThenBy(step => step.Sequence)
                                .FirstOrDefault();
                            string portalTitle = process.ScopeType switch
                            {
                                ProcessScopeType.Lead => "Company tipped in",
                                ProcessScopeType.Opportunity => "Opportunity created",
                                _ => "Client account created"
                            };
                            string portalDetail = process.ScopeType switch
                            {
                                ProcessScopeType.Lead => "Selected from the imported company pool",
                                ProcessScopeType.Opportunity => "A lead passed the qualification rule",
                                _ => "The account owner approved moving forward"
                            };
                            string portalCountDetail = process.ScopeType == ProcessScopeType.Lead
                                ? $"{process.PortalCount:N0} waiting in the pool"
                                : $"{process.PortalCount:N0} currently in this lane";

                            <section class="workflow-lane workflow-lane--@process.LaneKey" style="top:@(laneTop)px;width:@(stageWidth - 32)px;height:@(laneHeight)px" data-lane-id="@process.Id">
                                <header class="workflow-lane__header">
                                    <button type="button" data-inspector-template="process-template-@process.Id.ToString("N")">
                                        <span>@process.LaneLabel</span>
                                        <strong>@process.Name</strong>
                                        <small>v@(process.VersionNumber) · @process.Steps.Count steps</small>
                                    </button>
                                    <div data-live-key="lane-@process.Id.ToString("N")">
                                        <span>@process.ActiveInstances active</span>
                                        <span>@process.CompletedInstances completed</span>
                                        @if (process.UnmappedActiveInstances > 0)
                                        {
                                            <span class="has-warning">@process.UnmappedActiveInstances unmapped</span>
                                        }
                                    </div>
                                </header>
                            </section>

                            <button type="button"
                                    id="portal-@process.Id.ToString("N")"
                                    class="workflow-portal workflow-portal--@process.LaneKey workflow-graph-node"
                                    style="left:@(nodeStartLeft + (portalColumn * nodeColumnWidth) + portalColumnInset)px;top:@(laneTop + topRowOffset)px"
                                    data-node-row="0"
                                    data-node-column="@portalColumn"
                                    data-lane-id="@process.Id"
                                    data-inspector-template="process-template-@process.Id.ToString("N")">
                                <span>Starts here</span>
                                <strong>@portalTitle</strong>
                                <small>@portalDetail</small>
                                <b class="workflow-portal__count" data-live-key="portal-@process.Id.ToString("N")">@portalCountDetail</b>
                            </button>

                            @if (entryStep is not null)
                            {
                                <span class="workflow-edge-data"
                                      data-edge-from="portal-@process.Id.ToString("N")"
                                      data-edge-to="step-@entryStep.Id.ToString("N")"
                                      data-edge-label=""
                                      data-edge-kind="default"></span>
                            }

                            int edgeTrack = 0;
                            @for (int stepIndex = 0; stepIndex < process.Steps.Count; stepIndex++)
                            {
                                WorkflowStepViewModel step = process.Steps[stepIndex];
                                (int nodeRow, int nodeColumn) = stepLayout[step.Id];
                                int nodeLeft = nodeStartLeft + (nodeColumn * nodeColumnWidth);
                                int nodeTop = laneTop + topRowOffset + (nodeRow * nodeRowSpacing);
                                bool hasBranches = step.Transitions.Count > 1;
                                bool hasLoop = step.Transitions.Any(transition => transition.NextProcessStepId == step.Id);
                                <button type="button"
                                        id="step-@step.Id.ToString("N")"
                                        class="workflow-node workflow-node--@process.LaneKey workflow-graph-node @(hasLoop ? "has-iteration" : "")"
                                        style="left:@(nodeLeft)px;top:@(nodeTop)px"
                                        data-step-id="@step.Id"
                                        data-node-row="@nodeRow"
                                        data-node-column="@nodeColumn"
                                    data-lane-id="@process.Id"
                                    data-inspector-template="step-template-@step.Id.ToString("N")">
                                    @if (hasLoop)
                                    {
                                        <span class="workflow-node__iteration" title="This step can repeat" aria-label="Repeating step">↻</span>
                                    }
                                    <span class="workflow-node__meta"><b>@step.Sequence</b> @step.StepType</span>
                                    @if (step.Tasks.Count > 0 || step.ExecutionMode == "Human Managed")
                                    {
                                        <span class="workflow-node__badges">
                                            @if (step.Tasks.Count > 0)
                                            {
                                                <span class="workflow-node__tasks" title="@string.Join(" → ", step.Tasks.Select(task => task.Name))">@step.Tasks.Count child task@(step.Tasks.Count == 1 ? "" : "s")</span>
                                            }
                                        @if (step.ExecutionMode == "Human Managed")
                                        {
                                            <em class="workflow-node__owner" title="This step must be completed by a human">Human</em>
                                        }
                                        </span>
                                    }
                                    <strong>@step.Name</strong>
                                    <small>@step.Objective</small>
                                    <span class="workflow-node__footer" data-live-key="step-@step.Id.ToString("N")">
                                        <em class="is-current">@step.CurrentInstances here</em>
                                        @if (step.Health.Running > 0)
                                        {
                                            <em class="is-running">@step.Health.Running working</em>
                                        }
                                        else if (step.Health.Pending > 0)
                                        {
                                            <em>@step.Health.Pending waiting</em>
                                        }
                                        @if (hasBranches)
                                        {
                                            <em class="is-branching">@step.Transitions.Count routes</em>
                                        }
                                    </span>
                                </button>

                                @foreach (WorkflowTransitionViewModel transition in step.Transitions.Where(transition => transition.NextProcessStepId != step.Id))
                                {
                                    string edgeKind = transition.GraphTargetId.StartsWith("terminal-", StringComparison.Ordinal)
                                        ? "terminal"
                                        : transition.GraphTargetId.StartsWith("portal-", StringComparison.Ordinal)
                                            ? "handoff"
                                            : transition.IsDefault ? "default" : "branch";
                                    int edgeTrackIndex = edgeKind is "branch" or "terminal" ? edgeTrack++ : 0;
                                    <span class="workflow-edge-data"
                                          data-edge-from="step-@step.Id.ToString("N")"
                                          data-edge-to="@transition.GraphTargetId"
                                          data-edge-label="@transition.OutcomeKey"
                                          data-edge-kind="@edgeKind"
                                          data-edge-track="@edgeTrackIndex"></span>
                                }
                            }

                            @foreach (WorkflowTerminalNodeViewModel terminal in process.TerminalNodes)
                            {
                                (int terminalRow, int terminalColumn) = terminalLayout[terminal.GraphTargetId];
                                int terminalLeft = nodeStartLeft + (terminalColumn * nodeColumnWidth);
                                int terminalTop = laneTop + topRowOffset + (terminalRow * nodeRowSpacing);
                                <button type="button"
                                        id="@terminal.GraphTargetId"
                                        class="workflow-node workflow-end-node workflow-end-node--@process.LaneKey workflow-graph-node"
                                        style="left:@(terminalLeft)px;top:@(terminalTop)px"
                                        data-node-row="@terminalRow"
                                        data-node-column="@terminalColumn"
                                        data-lane-id="@process.Id"
                                        data-inspector-template="terminal-template-@terminal.GraphTargetId">
                                    <span class="workflow-node__meta">End state</span>
                                    <strong>@terminal.Name</strong>
                                    <small>@terminal.OutcomeLabel</small>
                                    <span class="workflow-node__footer" data-live-key="@terminal.GraphTargetId">
                                        <em class="is-current">@terminal.CurrentStateCount.ToString("N0") here</em>
                                        <em>@terminal.InboundRouteCount.ToString("N0") @(terminal.InboundRouteCount == 1 ? "route" : "routes")</em>
                                    </span>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <aside class="workflow-inspector" id="workflowInspector" aria-label="Workflow details" aria-live="polite">
                <header>
                    <div>
                        <span class="workflow-inspector__header-context" id="workflowInspectorContext">Workflow</span>
                        <strong id="workflowInspectorHeading">Workflow details</strong>
                    </div>
                    <button type="button" data-inspector-close aria-label="Close details">×</button>
                </header>
                <div class="workflow-inspector__content" id="workflowInspectorContent">
                    <div class="workflow-inspector__empty">
                        <span aria-hidden="true">↗</span>
                        <strong>Select a node</strong>
                        <p>Inspect what the agent receives, what the step adds, how it changes viability, and every route the engine permits next.</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <div class="workflow-inspector-templates" hidden>
        @foreach (WorkflowProcessViewModel process in Model.Processes)
        {
            <template id="process-template-@process.Id.ToString("N")"
                      data-heading="@process.Name"
                      data-context="@process.LaneLabel process · version @process.VersionNumber"
                      data-lane="@process.LaneKey"
                      data-live-template>
                <section class="workflow-inspector__process workflow-inspector__process--@process.LaneKey">
                    <p>@process.Description</p>
                    <dl class="workflow-inspector__metrics">
                        <div><dt>Active now</dt><dd>@process.ActiveInstances</dd></div>
                        <div><dt>Completed</dt><dd>@process.CompletedInstances</dd></div>
                        <div><dt>Steps</dt><dd>@process.Steps.Count</dd></div>
                    </dl>
                    <h3>Execution order</h3>
                    <ol class="workflow-inspector__step-list">
                        @foreach (WorkflowStepViewModel step in process.Steps.OrderBy(step => step.Sequence))
                        {
                            <li><button type="button" data-inspector-template="step-template-@step.Id.ToString("N")"><span>@step.Sequence</span><strong>@step.Name</strong><small>@step.ActionType</small></button></li>
                        }
                    </ol>
                    <a class="secondary-action" href="/Admin/Process/Edit/@process.Id">Edit this definition</a>
                </section>
            </template>
        }

        @foreach (WorkflowProcessViewModel process in Model.Processes)
        {
            @foreach (WorkflowStepViewModel step in process.Steps)
            {
                <template id="step-template-@step.Id.ToString("N")"
                          data-heading="@step.Name"
                          data-context="@process.Name · @step.ActionType · @step.ExecutionMode"
                          data-lane="@process.LaneKey"
                          data-live-template>
                    <section class="workflow-inspector__step workflow-inspector__step--@process.LaneKey">
                        <p class="workflow-inspector__objective">@step.Objective</p>

                        <div class="workflow-inspector__health">
                            <span><b>@step.CurrentInstances</b> here now</span>
                            <span><b>@step.Health.Running</b> working</span>
                            <span><b>@step.Health.Pending</b> waiting</span>
                            <span class="@(step.Health.Overdue > 0 ? "has-warning" : "")"><b>@step.Health.Overdue</b> overdue</span>
                            <span><b>@step.Health.Completed</b> done</span>
                        </div>

                        <dl class="workflow-inspector__contract">
                            <div><dt>Agent receives</dt><dd class="preserve-lines">@step.TaskInstructionsTemplate</dd></div>
                            <div><dt>Execution</dt><dd>@step.ExecutionMode</dd></div>
                            <div><dt>Information required</dt><dd class="preserve-lines">@(string.IsNullOrWhiteSpace(step.RequiredFacts) ? "No formal prerequisite facts declared." : step.RequiredFacts)</dd></div>
                            <div><dt>Information added</dt><dd class="preserve-lines">@(string.IsNullOrWhiteSpace(step.ProducedFacts) ? "The result is recorded in the company history; no named fact is declared." : step.ProducedFacts)</dd></div>
                            <div><dt>Viability impact</dt><dd class="preserve-lines">@(string.IsNullOrWhiteSpace(step.ViabilityImpact) ? "No explicit viability impact declared." : step.ViabilityImpact)</dd></div>
                            <div><dt>State on entry</dt><dd>@step.StateOnActivate</dd></div>
                            <div><dt>Due</dt><dd>@(step.DueAfterDays == 0 && step.DueAfterHours == 0 ? "Immediately" : $"After {step.DueAfterDays} day(s), {step.DueAfterHours} hour(s)")</dd></div>
                        </dl>

                        <h3>Execution tasks</h3>
                        @if (step.Tasks.Count == 0)
                        {
                            <p class="workflow-inspector__implicit-task">Implicit inference — this step has no explicit child-task sequence.</p>
                        }
                        else
                        {
                            <ol class="workflow-inspector__tasks">
                                @foreach (WorkflowStepTaskViewModel task in step.Tasks)
                                {
                                    <li>
                                        <span>@task.Sequence</span>
                                        <div><strong>@task.Name</strong><small>@task.Type · <code>@task.HandlerKey</code> · max @task.MaxAttempts attempt@(task.MaxAttempts == 1 ? "" : "s")</small></div>
                                    </li>
                                }
                            </ol>
                        }

                        @if (!string.IsNullOrWhiteSpace(step.QuestionSetTemplate))
                        {
                            <details class="workflow-inspector__questions"><summary>Expected answer shape</summary><p class="preserve-lines">@step.QuestionSetTemplate</p></details>
                        }

                        <h3>Permitted next routes</h3>
                        <div class="workflow-inspector__routes">
                            @if (step.Transitions.Count == 0)
                            {
                                <p class="workflow-inspector__warning">No transition is configured. The process cannot advance from this step.</p>
                            }
                            @foreach (WorkflowTransitionViewModel transition in step.Transitions)
                            {
                                <article class="@(transition.IsDefault ? "is-default" : "") @(transition.IsTerminal ? "is-terminal" : "")">
                                    <header>
                                        <code>@transition.OutcomeKey</code>
                                        @if (transition.IsDefault)
                                        {
                                            <span>Default</span>
                                        }
                                    </header>
                                    <strong>@transition.OutcomeLabel</strong>
                                    <dl>
                                        <div><dt>Follow when</dt><dd>The current task completes with outcome <code>@transition.OutcomeKey</code>.</dd></div>
                                        <div><dt>Then</dt><dd>@transition.DestinationLabel</dd></div>
                                        <div><dt>Engine effect</dt><dd>@transition.EffectLabel</dd></div>
                                        <div><dt>Resulting state</dt><dd>@transition.ResultingState</dd></div>
                                        <div><dt>Used</dt><dd>@transition.HistoricalCompletedCount.ToString("N0") completed task@(transition.HistoricalCompletedCount == 1 ? "" : "s") took this route.</dd></div>
                                        @if (transition.CurrentStateCount > 0 || transition.IsTerminal || transition.GraphTargetId.StartsWith("portal-", StringComparison.Ordinal))
                                        {
                                            <div><dt>There now</dt><dd>@transition.CurrentStateCount.ToString("N0") compan@(transition.CurrentStateCount == 1 ? "y is" : "ies are") currently in the resulting state.</dd></div>
                                        }
                                    </dl>
                                </article>
                            }
                        </div>
                    </section>
                </template>

            }

            @foreach (WorkflowTerminalNodeViewModel terminal in process.TerminalNodes)
            {
                <template id="terminal-template-@terminal.GraphTargetId"
                          data-heading="@terminal.Name"
                          data-context="@process.Name · shared end state"
                          data-lane="@process.LaneKey"
                          data-live-template>
                    <section class="workflow-inspector__step workflow-inspector__step--@process.LaneKey">
                        <p class="workflow-inspector__objective">One shared lifecycle state for every route that produces this outcome. Companies can be inspected individually or moved together after their evidence has been corrected.</p>
                        <dl class="workflow-inspector__contract">
                            <div><dt>Current companies</dt><dd>@terminal.CurrentStateCount.ToString("N0")</dd></div>
                            <div><dt>Historical route uses</dt><dd>@terminal.HistoricalCompletedCount.ToString("N0") task completions</dd></div>
                            <div><dt>Engine effect</dt><dd>@terminal.EffectLabel</dd></div>
                            <div><dt>Resulting state</dt><dd>@terminal.ResultingState</dd></div>
                        </dl>

                        <h3>Why companies are here</h3>
                        @if (terminal.CurrentStateReasons.Count == 0)
                        {
                            <p>No more specific reason is recorded for this outcome yet.</p>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead><tr><th>Reason</th><th>Companies</th><th>Share</th></tr></thead>
                                <tbody>
                                @foreach (WorkflowOutcomeReasonViewModel reason in terminal.CurrentStateReasons)
                                {
                                    decimal reasonShare = terminal.CurrentStateCount == 0 ? 0 : (decimal)reason.Count / terminal.CurrentStateCount;
                                    <tr>
                                        <td><strong>@reason.Label</strong><br /><small>@reason.Detail</small></td>
                                        <td>@reason.Count.ToString("N0")</td>
                                        <td>@reasonShare.ToString("P1")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (!string.IsNullOrWhiteSpace(terminal.CurrentStateHref))
                        {
                            <a class="primary-action" href="@terminal.CurrentStateHref">View and manage individual companies</a>
                        }

                        @if (process.ScopeType == ProcessScopeType.Lead
                            && terminal.Effect is ProcessTransitionEffect.DeferLead or ProcessTransitionEffect.RejectLead
                            && process.Steps.Count > 0)
                        {
                            <h3>Move all companies</h3>
                            <form class="process-state-control" method="post" action="/Admin/Process/MoveTerminalLeads">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="effect" value="@terminal.Effect" />
                                <label>
                                    Process state
                                    <select name="processStepId" required>
                                        <option value="">Choose a process state</option>
                                        @foreach (WorkflowStepViewModel targetStep in process.Steps.OrderBy(step => step.Sequence))
                                        {
                                            <option value="@targetStep.Id">@targetStep.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Audit reason
                                    <input name="reason" maxlength="1000" placeholder="What was corrected or why should these be reprocessed?" />
                                </label>
                                <button type="submit" class="secondary-action">Move all @terminal.CurrentStateCount.ToString("N0") companies</button>
                            </form>
                        }
                    </section>
                </template>
            }
        }
    </div>
</main>

<script>
(() => {
    const viewport = document.getElementById('workflowViewport');
    const space = document.getElementById('workflowSpace');
    const stage = document.getElementById('workflowStage');
    const svg = document.getElementById('workflowConnectors');
    const zoomOutput = document.getElementById('workflowZoom');
    const inspector = document.getElementById('workflowInspector');
    const inspectorHeading = document.getElementById('workflowInspectorHeading');
    const inspectorContext = document.getElementById('workflowInspectorContext');
    const inspectorContent = document.getElementById('workflowInspectorContent');
    const refreshToggle = document.querySelector('[data-workflow-auto-refresh]');
    const refreshStatus = document.getElementById('workflowRefreshStatus');
    const stageWidth = Number(stage.dataset.width);
    const stageHeight = Number(stage.dataset.height);
    const svgNamespace = 'http://www.w3.org/2000/svg';
    const arrowTipReach = 14;
    let scale = 1;
    let dragging = false;
    let dragStart = null;
    let activeTemplateId = null;
    let refreshInProgress = false;

    function positionScaledStage() {
        const scaledWidth = stageWidth * scale;
        const horizontalInset = Math.max(0, (viewport.clientWidth - scaledWidth) / 2);
        stage.style.left = `${horizontalInset}px`;
        space.style.width = `${Math.max(viewport.clientWidth, scaledWidth + (horizontalInset * 2))}px`;
        space.style.height = `${stageHeight * scale}px`;
    }

    function setScale(nextScale, preserveCentre = true) {
        const previousScale = scale;
        const centreX = (viewport.scrollLeft + viewport.clientWidth / 2) / previousScale;
        const centreY = (viewport.scrollTop + viewport.clientHeight / 2) / previousScale;
        scale = Math.max(.52, Math.min(1.35, nextScale));
        stage.style.transform = `scale(${scale})`;
        positionScaledStage();
        zoomOutput.value = `${Math.round(scale * 100)}%`;
        zoomOutput.textContent = zoomOutput.value;
        if (preserveCentre) {
            viewport.scrollLeft = Math.max(0, centreX * scale - viewport.clientWidth / 2);
            viewport.scrollTop = Math.max(0, centreY * scale - viewport.clientHeight / 2);
        }
    }

    function fitSurface() {
        const horizontal = (viewport.clientWidth - 24) / stageWidth;
        setScale(Math.min(.96, horizontal), false);
        viewport.scrollTo({ left: 0, top: 0 });
    }

    function nodeCentre(node) {
        return {
            x: node.offsetLeft + node.offsetWidth / 2,
            y: node.offsetTop + node.offsetHeight / 2
        };
    }

    function hasTerminalObstacleBelow(from, to) {
        const laneId = from.dataset.laneId;
        const left = Math.min(from.offsetLeft, to.offsetLeft);
        const right = Math.max(from.offsetLeft + from.offsetWidth, to.offsetLeft + to.offsetWidth);
        const rowBottom = Math.max(from.offsetTop + from.offsetHeight, to.offsetTop + to.offsetHeight);

        return [...document.querySelectorAll('.workflow-end-node')].some(terminal => terminal.dataset.laneId === laneId
            && terminal.offsetTop >= rowBottom
            && terminal.offsetLeft < right
            && terminal.offsetLeft + terminal.offsetWidth > left);
    }

    function hasNodeBetweenColumns(from, to) {
        if (from.dataset.laneId !== to.dataset.laneId
            || from.dataset.nodeRow !== to.dataset.nodeRow)
            return false;

        const fromColumn = Number(from.dataset.nodeColumn);
        const toColumn = Number(to.dataset.nodeColumn);
        const firstColumn = Math.min(fromColumn, toColumn);
        const lastColumn = Math.max(fromColumn, toColumn);

        return [...document.querySelectorAll('.workflow-graph-node')].some(node => node !== from
            && node !== to
            && node.dataset.laneId === from.dataset.laneId
            && node.dataset.nodeRow === from.dataset.nodeRow
            && Number(node.dataset.nodeColumn) > firstColumn
            && Number(node.dataset.nodeColumn) < lastColumn);
    }

    function chooseConnectorSides(edge, from, to) {
        if (from === to) return { fromSide: 'left', toSide: 'top', route: 'loop' };
        const fromCentre = nodeCentre(from);
        const toCentre = nodeCentre(to);
        const deltaX = toCentre.x - fromCentre.x;
        const deltaY = toCentre.y - fromCentre.y;
        const sameRow = from.dataset.nodeRow === to.dataset.nodeRow;
        const sameColumn = from.dataset.nodeColumn === to.dataset.nodeColumn;
        const sourceAboveTarget = from.offsetTop + from.offsetHeight <= to.offsetTop;
        const sourceBelowTarget = to.offsetTop + to.offsetHeight <= from.offsetTop;

        if (edge.kind === 'handoff') return Math.abs(deltaX) < 1
            ? { fromSide: 'bottom', toSide: 'top', route: 'direct' }
            : { fromSide: 'bottom', toSide: deltaX >= 0 ? 'left' : 'right', route: 'handoff' };

        if (edge.kind === 'terminal') {
            if (sameRow && hasNodeBetweenColumns(from, to))
                return { fromSide: 'top', toSide: 'top', route: 'row-channel' };

            if (sourceAboveTarget)
                return { fromSide: 'bottom', toSide: 'top', route: 'terminal-channel' };

            if (sourceBelowTarget)
                return { fromSide: 'top', toSide: 'bottom', route: 'terminal-channel' };
        }

        if (edge.kind === 'branch' && sameColumn && !sameRow)
            return deltaY < 0
                ? { fromSide: 'top', toSide: 'bottom', route: 'parallel-return' }
                : { fromSide: 'bottom', toSide: 'top', route: 'vertical' };

        if (edge.kind === 'branch' && sameRow && deltaX < 0) {
            // Keep a forward branch out of the lower corridor when a terminal
            // route already occupies it. The upper lane gutter is clearer and
            // keeps the branch label associated with its decision.
            const side = hasTerminalObstacleBelow(from, to) || from.dataset.nodeRow !== '0'
                ? 'top'
                : 'bottom';
            return { fromSide: side, toSide: side, route: 'row-channel' };
        }

        if (sameRow) {
            return deltaX >= 0
                ? { fromSide: 'right', toSide: 'left', route: 'horizontal' }
                : { fromSide: 'left', toSide: 'right', route: 'horizontal' };
        }

        if (sourceAboveTarget)
            return { fromSide: 'bottom', toSide: 'top', route: 'vertical' };

        if (sourceBelowTarget)
            return { fromSide: 'top', toSide: 'bottom', route: 'vertical' };

        return deltaX >= 0
            ? { fromSide: 'right', toSide: 'left', route: 'horizontal' }
            : { fromSide: 'left', toSide: 'right', route: 'horizontal' };
    }

    function pointOnPort(node, side, rate) {
        const left = node.offsetLeft;
        const top = node.offsetTop;
        const right = left + node.offsetWidth;
        const bottom = top + node.offsetHeight;
        if (side === 'top') return { x: left + node.offsetWidth * rate, y: top };
        if (side === 'bottom') return { x: left + node.offsetWidth * rate, y: bottom };
        if (side === 'left') return { x: left, y: top + node.offsetHeight * rate };
        return { x: right, y: top + node.offsetHeight * rate };
    }

    function moveOut(point, side, distance) {
        if (side === 'top') return { x: point.x, y: point.y - distance };
        if (side === 'bottom') return { x: point.x, y: point.y + distance };
        if (side === 'left') return { x: point.x - distance, y: point.y };
        return { x: point.x + distance, y: point.y };
    }

    function clamp(value, minimum, maximum) {
        return Math.max(minimum, Math.min(maximum, value));
    }

    function isStraightThroughRoute(plan) {
        const fromCentre = nodeCentre(plan.from);
        const toCentre = nodeCentre(plan.to);
        return plan.sides.route === 'direct'
            || (plan.kind === 'default' && (
                (plan.sides.route === 'horizontal' && Math.abs(fromCentre.y - toCentre.y) < 1)
                || (plan.sides.route === 'vertical' && Math.abs(fromCentre.x - toCentre.x) < 1)));
    }

    function compactPoints(points) {
        const unique = points.filter((point, index) => index === 0
            || point.x !== points[index - 1].x
            || point.y !== points[index - 1].y);
        const simplified = [];
        unique.forEach(point => {
            while (simplified.length >= 2) {
                const previous = simplified[simplified.length - 1];
                const beforePrevious = simplified[simplified.length - 2];
                if ((beforePrevious.x === previous.x && previous.x === point.x)
                    || (beforePrevious.y === previous.y && previous.y === point.y))
                    simplified.pop();
                else
                    break;
            }
            simplified.push(point);
        });
        return simplified;
    }

    function pathFromPoints(points) {
        return points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');
    }

    function moveConnectorEndToArrowStem(points, targetSide) {
        const adjusted = [...points];
        adjusted[adjusted.length - 1] = moveOut(adjusted[adjusted.length - 1], targetSide, arrowTipReach);
        return adjusted;
    }

    function rowCorridorY(from, to, fallbackY) {
        return rowCorridorYCandidates(from, to, fallbackY)[0] ?? fallbackY;
    }

    function rowCorridorYCandidates(from, to, fallbackY) {
        const sameLaneNodes = [...document.querySelectorAll('.workflow-graph-node')]
            .filter(node => node.dataset.laneId === from.dataset.laneId);
        const fromTop = from.offsetTop;
        const fromBottom = from.offsetTop + from.offsetHeight;
        const toTop = to.offsetTop;
        const toBottom = to.offsetTop + to.offsetHeight;
        const candidates = [];

        if (fromBottom <= toTop) {
            const rowTops = [...new Set(sameLaneNodes
                .filter(node => node.offsetTop > fromBottom && node.offsetTop <= toTop)
                .map(node => node.offsetTop))]
                .sort((left, right) => left - right);
            rowTops.forEach(rowTop => candidates.push((fromBottom + rowTop) / 2));
            candidates.push((fromBottom + toTop) / 2);
        }

        if (toBottom <= fromTop) {
            const rowBottoms = [...new Set(sameLaneNodes
                .filter(node => node.offsetTop + node.offsetHeight < fromTop && node.offsetTop + node.offsetHeight >= toBottom)
                .map(node => node.offsetTop + node.offsetHeight))]
                .sort((left, right) => right - left);
            rowBottoms.forEach(rowBottom => candidates.push((rowBottom + fromTop) / 2));
            candidates.push((toBottom + fromTop) / 2);
        }

        candidates.push(fallbackY);
        return [...new Set(candidates.map(candidate => Math.round(candidate)))]
            .filter(candidate => Number.isFinite(candidate));
    }

    function oppositeGutterSides(plan) {
        const fromCentre = nodeCentre(plan.from);
        const toCentre = nodeCentre(plan.to);
        const deltaX = toCentre.x - fromCentre.x;
        const deltaY = toCentre.y - fromCentre.y;

        if (Math.abs(deltaY) >= Math.abs(deltaX))
            return deltaY >= 0
                ? { fromSide: 'top', toSide: 'top', route: 'reroute' }
                : { fromSide: 'bottom', toSide: 'bottom', route: 'reroute' };

        return deltaX >= 0
            ? { fromSide: 'left', toSide: 'left', route: 'reroute' }
            : { fromSide: 'right', toSide: 'right', route: 'reroute' };
    }

    function oppositeGutterToNearestSide(plan) {
        const fromCentre = nodeCentre(plan.from);
        const toCentre = nodeCentre(plan.to);
        const deltaX = toCentre.x - fromCentre.x;
        const deltaY = toCentre.y - fromCentre.y;

        if (Math.abs(deltaY) >= Math.abs(deltaX))
            return deltaY >= 0
                ? { fromSide: 'top', toSide: deltaX >= 0 ? 'left' : 'right', route: 'reroute' }
                : { fromSide: 'bottom', toSide: deltaX >= 0 ? 'left' : 'right', route: 'reroute' };

        return deltaX >= 0
            ? { fromSide: deltaY >= 0 ? 'top' : 'bottom', toSide: 'left', route: 'reroute' }
            : { fromSide: deltaY >= 0 ? 'top' : 'bottom', toSide: 'right', route: 'reroute' };
    }

    function longWayAroundVariants(plan) {
        const fromCentre = nodeCentre(plan.from);
        const toCentre = nodeCentre(plan.to);
        const deltaX = toCentre.x - fromCentre.x;
        const deltaY = toCentre.y - fromCentre.y;
        const verticalPreference = deltaY >= 0 ? ['top', 'bottom'] : ['bottom', 'top'];
        const horizontalPreference = deltaX >= 0 ? ['left', 'right'] : ['right', 'left'];

        if (Math.abs(deltaX) >= Math.abs(deltaY)) {
            return verticalPreference.flatMap(fromSide =>
                horizontalPreference.map(toSide => ({
                    sides: { fromSide, toSide, route: 'reroute' },
                    offset: 1,
                    fromRate: .5,
                    toRate: .5
                })));
        }

        return horizontalPreference.flatMap(fromSide =>
            verticalPreference.map(toSide => ({
                sides: { fromSide, toSide, route: 'reroute' },
                offset: 1,
                fromRate: .5,
                toRate: .5
            })));
    }

    function labelOnLongestSegment(points) {
        let chosen = null;
        for (let index = 1; index < points.length - 2; index++) {
            const start = points[index];
            const end = points[index + 1];
            const length = Math.abs(end.x - start.x) + Math.abs(end.y - start.y);
            if (!chosen || length > chosen.length) chosen = { start, end, length };
        }
        chosen ||= { start: points[0], end: points[points.length - 1], length: 0 };
        const horizontal = chosen.start.y === chosen.end.y;
        return {
            x: (chosen.start.x + chosen.end.x) / 2 + (horizontal ? 0 : 7),
            y: (chosen.start.y + chosen.end.y) / 2 + (horizontal ? -6 : 3),
            anchor: horizontal ? 'middle' : 'start'
        };
    }

    function outsideNodeCorridorX(from, to, side, gutter) {
        return side === 'left'
            ? Math.min(from.offsetLeft, to.offsetLeft) - gutter
            : Math.max(from.offsetLeft + from.offsetWidth, to.offsetLeft + to.offsetWidth) + gutter;
    }

    function outsideNodeCorridorY(from, to, side, gutter) {
        return side === 'top'
            ? Math.min(from.offsetTop, to.offsetTop) - gutter
            : Math.max(from.offsetTop + from.offsetHeight, to.offsetTop + to.offsetHeight) + gutter;
    }

    function connectorGeometry(plan, variant = {}) {
        const sides = variant.sides || plan.sides;
        const offset = variant.offset || 0;
        const track = plan.track + offset;
        const fromRate = variant.fromRate ?? plan.fromRate;
        const toRate = variant.toRate ?? plan.toRate;
        const start = pointOnPort(plan.from, sides.fromSide, fromRate);
        const end = pointOnPort(plan.to, sides.toSide, toRate);
        const startOut = moveOut(start, sides.fromSide, 18 + (offset * 8));
        const endOut = moveOut(end, sides.toSide, 18 + (offset * 8));
        let points;

        if (offset === 0 && (sides.route === 'direct' || sides.route === 'parallel-return')) {
            points = [start, end];
        } else if (sides.route === 'handoff') {
            const sourceLane = document.querySelector(`.workflow-lane[data-lane-id="${CSS.escape(plan.from.dataset.laneId)}"]`);
            const laneCorridorY = sourceLane ? sourceLane.offsetTop + sourceLane.offsetHeight + 9 : startOut.y + 46;
            const leftCorridorX = 18 + ((track % 2) * 8);
            points = [start, startOut, { x: startOut.x, y: laneCorridorY }, { x: leftCorridorX, y: laneCorridorY }, { x: leftCorridorX, y: endOut.y }, endOut, end];
        } else if (sides.route === 'row-side'
            && (sides.fromSide === 'top' || sides.fromSide === 'bottom')
            && (sides.toSide === 'left' || sides.toSide === 'right')) {
            const corridorY = variant.corridorY ?? rowCorridorY(plan.from, plan.to, (startOut.y + endOut.y) / 2);
            points = [start, startOut, { x: startOut.x, y: corridorY }, { x: endOut.x, y: corridorY }, endOut, end];
        } else if (sides.route === 'reroute') {
            if (sides.fromSide === 'left' || sides.fromSide === 'right') {
                const direction = sides.fromSide === 'left' ? -1 : 1;
                const corridorX = outsideNodeCorridorX(plan.from, plan.to, sides.fromSide, 12 + (offset * 10));
                points = [start, startOut, { x: corridorX, y: startOut.y }, { x: corridorX, y: endOut.y }, endOut, end];
            } else {
                const direction = sides.fromSide === 'top' ? -1 : 1;
                const corridorY = outsideNodeCorridorY(plan.from, plan.to, sides.fromSide, 12 + (offset * 10));
                if (sides.toSide === 'left' || sides.toSide === 'right') {
                    const targetCorridorX = outsideNodeCorridorX(plan.from, plan.to, sides.toSide, 12 + (offset * 10));
                    points = [start, startOut, { x: startOut.x, y: corridorY }, { x: targetCorridorX, y: corridorY }, { x: targetCorridorX, y: endOut.y }, endOut, end];
                } else {
                    points = [start, startOut, { x: startOut.x, y: corridorY }, { x: endOut.x, y: corridorY }, endOut, end];
                }
            }
        } else if (sides.fromSide === sides.toSide) {
            if (sides.fromSide === 'left' || sides.fromSide === 'right') {
                const corridorX = outsideNodeCorridorX(plan.from, plan.to, sides.fromSide, 6 + ((track % 3) * 8));
                points = [start, startOut, { x: corridorX, y: startOut.y }, { x: corridorX, y: endOut.y }, endOut, end];
            } else {
                const corridorY = outsideNodeCorridorY(plan.from, plan.to, sides.fromSide, 9 + ((track % 4) * 9));
                points = [start, startOut, { x: startOut.x, y: corridorY }, { x: endOut.x, y: corridorY }, endOut, end];
            }
        } else if ((sides.fromSide === 'left' || sides.fromSide === 'right')
            && (sides.toSide === 'left' || sides.toSide === 'right')) {
            const middleX = (startOut.x + endOut.x) / 2 + (((track % 5) - 2) * 8);
            points = [start, startOut, { x: middleX, y: startOut.y }, { x: middleX, y: endOut.y }, endOut, end];
        } else if ((sides.fromSide === 'top' || sides.fromSide === 'bottom')
            && (sides.toSide === 'top' || sides.toSide === 'bottom')) {
            const middleY = (variant.corridorY ?? rowCorridorY(plan.from, plan.to, (startOut.y + endOut.y) / 2))
                + (((track % 5) - 2) * 8);
            points = [start, startOut, { x: startOut.x, y: middleY }, { x: endOut.x, y: middleY }, endOut, end];
        } else {
            const elbow = sides.fromSide === 'left' || sides.fromSide === 'right'
                ? { x: endOut.x, y: startOut.y }
                : { x: startOut.x, y: endOut.y };
            points = [start, startOut, elbow, endOut, end];
        }

        points = compactPoints(moveConnectorEndToArrowStem(points, sides.toSide));
        const label = labelOnLongestSegment(points);
        if (plan.kind === 'branch' && sides.route === 'vertical' && plan.to.offsetTop > plan.from.offsetTop)
            label.y = plan.from.offsetTop + plan.from.offsetHeight + 22;
        if (sides.route === 'parallel-return') {
            label.x = start.x + 8;
            label.y = (start.y + end.y) / 2 + 3;
            label.anchor = 'start';
        }
        return {
            d: pathFromPoints(points),
            label,
            points,
            fromRate,
            toRate,
            reservedTerminalFanIn: variant.reservedTerminalFanIn || false
        };
    }

    function connectorSegments(points) {
        return points.slice(1).map((point, index) => ({ start: points[index], end: point }));
    }

    function rangesTouch(firstStart, firstEnd, secondStart, secondEnd) {
        return Math.max(Math.min(firstStart, firstEnd), Math.min(secondStart, secondEnd))
            <= Math.min(Math.max(firstStart, firstEnd), Math.max(secondStart, secondEnd));
    }

    function connectorSegmentsCross(first, second) {
        const firstHorizontal = first.start.y === first.end.y;
        const secondHorizontal = second.start.y === second.end.y;
        if (firstHorizontal === secondHorizontal) {
            if (firstHorizontal && first.start.y !== second.start.y) return false;
            if (!firstHorizontal && first.start.x !== second.start.x) return false;
            return firstHorizontal
                ? rangesTouch(first.start.x, first.end.x, second.start.x, second.end.x)
                : rangesTouch(first.start.y, first.end.y, second.start.y, second.end.y);
        }

        const horizontal = firstHorizontal ? first : second;
        const vertical = firstHorizontal ? second : first;
        return rangesTouch(horizontal.start.x, horizontal.end.x, vertical.start.x, vertical.start.x)
            && rangesTouch(vertical.start.y, vertical.end.y, horizontal.start.y, horizontal.start.y);
    }

    function geometriesCross(first, second) {
        return connectorSegments(first.points).some(firstSegment =>
            connectorSegments(second.points).some(secondSegment => connectorSegmentsCross(firstSegment, secondSegment)));
    }

    function segmentPassesThroughNode(segment, node) {
        const left = node.offsetLeft;
        const right = left + node.offsetWidth;
        const top = node.offsetTop;
        const bottom = top + node.offsetHeight;
        if (segment.start.y === segment.end.y) {
            return segment.start.y > top && segment.start.y < bottom
                && Math.max(Math.min(segment.start.x, segment.end.x), left)
                    < Math.min(Math.max(segment.start.x, segment.end.x), right);
        }

        return segment.start.x > left && segment.start.x < right
            && Math.max(Math.min(segment.start.y, segment.end.y), top)
                < Math.min(Math.max(segment.start.y, segment.end.y), bottom);
    }

    function geometryCollides(plan, geometry, occupiedSegments) {
        const score = geometryCollisionScore(plan, geometry, occupiedSegments);
        return score.nodeHits > 0 || score.lineHits > 0 || score.endpointHits > 0;
    }

    function geometryCollisionScore(plan, geometry, occupiedSegments) {
        const segments = connectorSegments(geometry.points);
        const nodes = [...document.querySelectorAll('.workflow-graph-node')]
            .filter(node => node !== plan.from && node !== plan.to);
        return {
            nodeHits: segments.reduce((total, segment) =>
                total + nodes.filter(node => segmentPassesThroughNode(segment, node)).length, 0),
            lineHits: segments.reduce((total, segment) =>
                total + occupiedSegments.filter(occupied =>
                    occupied.kind !== 'handoff' && connectorSegmentsCross(segment, occupied)).length, 0),
            endpointHits: segments.reduce((total, segment, index) =>
                total
                + (index > 0 && segmentPassesThroughNode(segment, plan.from) ? 1 : 0)
                + (index < segments.length - 1 && segmentPassesThroughNode(segment, plan.to) ? 1 : 0), 0)
        };
    }

    function geometryScore(plan, geometry, occupiedSegments) {
        const collisionScore = geometryCollisionScore(plan, geometry, occupiedSegments);
        const length = geometryLength(geometry);
        const bendCount = geometryBendCount(geometry);
        return (collisionScore.nodeHits * 100000)
            + (collisionScore.endpointHits * 100000)
            + (collisionScore.lineHits * 1000)
            + (bendCount * 40)
            + length
            + ((Math.abs((geometry.fromRate ?? .5) - .5) + Math.abs((geometry.toRate ?? .5) - .5)) * 2000)
            + (geometry.reservedTerminalFanIn ? 1000 : 0);
    }

    function geometryLength(geometry) {
        return connectorSegments(geometry.points).reduce((total, segment) =>
            total + Math.abs(segment.end.x - segment.start.x) + Math.abs(segment.end.y - segment.start.y), 0);
    }

    function geometryBendCount(geometry) {
        return Math.max(0, geometry.points.length - 2);
    }

    function rankedGeometryCandidates(plan, occupiedSegments, variants) {
        return variants
            .map(variant => connectorGeometry(plan, variant))
            .map(geometry => ({ geometry, score: geometryScore(plan, geometry, occupiedSegments) }))
            .sort((left, right) => left.score - right.score);
    }

    function bestNonCollidingGeometry(plan, occupiedSegments, variants) {
        return rankedGeometryCandidates(plan, occupiedSegments, variants)
            .find(candidate => !geometryCollides(plan, candidate.geometry, occupiedSegments))
            ?.geometry;
    }

    function routeForSides(fromSide, toSide, from, to) {
        const fromVertical = fromSide === 'top' || fromSide === 'bottom';
        const toVertical = toSide === 'top' || toSide === 'bottom';
        if (fromVertical && toVertical) return 'vertical';
        if (!fromVertical && !toVertical) return 'horizontal';

        const sourceAboveTarget = from.offsetTop + from.offsetHeight <= to.offsetTop;
        const sourceBelowTarget = to.offsetTop + to.offsetHeight <= from.offsetTop;
        if (fromVertical && !toVertical && (sourceAboveTarget || sourceBelowTarget))
            return 'row-side';

        return 'elbow';
    }

    function terminalSideReservedBySameRowFanIn(plan, toSide) {
        if (plan.kind !== 'terminal'
            || (toSide !== 'left' && toSide !== 'right')
            || plan.from.dataset.nodeRow === plan.to.dataset.nodeRow)
            return false;

        return [...document.querySelectorAll('.workflow-edge-data')]
            .filter(edge => edge.dataset.edgeKind === 'terminal'
                && edge.dataset.edgeTo === plan.to.id
                && edge.dataset.edgeFrom !== plan.from.id)
            .some(edge => {
                const otherFrom = document.getElementById(edge.dataset.edgeFrom);
                if (!otherFrom || otherFrom.dataset.nodeRow !== plan.to.dataset.nodeRow)
                    return false;

                const otherCentre = nodeCentre(otherFrom);
                const targetCentre = nodeCentre(plan.to);
                const reservedSide = otherCentre.x <= targetCentre.x ? 'left' : 'right';
                return reservedSide === toSide;
            });
    }

    function sideOptimisationVariants(plan) {
        const sides = ['top', 'right', 'bottom', 'left'];
        const fromRates = [...new Set([.5, .45, .55, plan.fromRate ?? .5])]
            .filter(rate => Number.isFinite(rate));
        const toRates = [.5];
        const variants = [];
        sides.forEach(fromSide => {
            sides.forEach(toSide => {
                if (fromSide === plan.sides.fromSide && toSide === plan.sides.toSide)
                    return;

                const route = routeForSides(fromSide, toSide, plan.from, plan.to);
                const fromVertical = fromSide === 'top' || fromSide === 'bottom';
                const toVertical = toSide === 'top' || toSide === 'bottom';
                const routes = fromVertical !== toVertical
                    ? [...new Set([route, 'elbow'])]
                    : [route];

                routes.forEach(candidateRoute => {
                    fromRates.forEach(fromRate => {
                        toRates.forEach(toRate => variants.push({
                            sides: { fromSide, toSide, route: candidateRoute },
                            fromRate,
                            toRate,
                            reservedTerminalFanIn: terminalSideReservedBySameRowFanIn(plan, toSide)
                        }));
                    });
                });
            });
        });
        return variants;
    }

    function optimiseConnectionSides(plan, occupiedSegments, chosenGeometry) {
        const chosenLength = geometryLength(chosenGeometry);
        const chosenBends = geometryBendCount(chosenGeometry);
        const chosenScore = geometryScore(plan, chosenGeometry, occupiedSegments);
        const candidates = rankedGeometryCandidates(plan, occupiedSegments, sideOptimisationVariants(plan))
            .filter(candidate => !geometryCollides(plan, candidate.geometry, occupiedSegments));

        for (const candidate of candidates) {
            const candidateLength = geometryLength(candidate.geometry);
            const candidateBends = geometryBendCount(candidate.geometry);
            const candidateScore = geometryScore(plan, candidate.geometry, occupiedSegments);
            const shorterWithoutMoreBends = candidateLength < chosenLength - 1 && candidateBends <= chosenBends;
            const fewerBendsWithoutMoreLength = candidateBends < chosenBends && candidateLength <= chosenLength + 1;
            const materiallyCleaner = candidateScore < chosenScore - 1
                && candidateLength <= chosenLength + 1
                && candidateBends <= chosenBends;
            if (shorterWithoutMoreBends || fewerBendsWithoutMoreLength || materiallyCleaner)
                return candidate.geometry;
        }

        return chosenGeometry;
    }

    function rowCorridorVariants(plan) {
        const sides = plan.sides;
        if (!((sides.fromSide === 'top' || sides.fromSide === 'bottom')
            && (sides.toSide === 'top' || sides.toSide === 'bottom')))
            return [];

        const start = pointOnPort(plan.from, sides.fromSide, plan.fromRate);
        const end = pointOnPort(plan.to, sides.toSide, plan.toRate);
        const startOut = moveOut(start, sides.fromSide, 18);
        const endOut = moveOut(end, sides.toSide, 18);
        const corridors = rowCorridorYCandidates(plan.from, plan.to, (startOut.y + endOut.y) / 2);
        const offsets = [0, -8, 8, -16, 16, -24, 24];
        return corridors.flatMap(corridorY => offsets.map(offset => ({ corridorY: corridorY + offset })));
    }

    function rowCorridorToSideVariants(plan) {
        const fromCentre = nodeCentre(plan.from);
        const toCentre = nodeCentre(plan.to);
        const deltaX = toCentre.x - fromCentre.x;
        const sourceAboveTarget = plan.from.offsetTop + plan.from.offsetHeight <= plan.to.offsetTop;
        const sourceBelowTarget = plan.to.offsetTop + plan.to.offsetHeight <= plan.from.offsetTop;
        if (!sourceAboveTarget && !sourceBelowTarget) return [];

        const fromSide = sourceAboveTarget ? 'bottom' : 'top';
        const toSides = deltaX >= 0 ? ['left', 'right'] : ['right', 'left'];
        const start = pointOnPort(plan.from, fromSide, plan.fromRate);
        const end = pointOnPort(plan.to, toSides[0], plan.toRate);
        const startOut = moveOut(start, fromSide, 18);
        const endOut = moveOut(end, toSides[0], 18);
        const corridors = rowCorridorYCandidates(plan.from, plan.to, (startOut.y + endOut.y) / 2);
        const offsets = [0, -8, 8, -16, 16, -24, 24];

        return toSides.flatMap(toSide =>
            corridors.flatMap(corridorY =>
                offsets.map(offset => ({
                    sides: { fromSide, toSide, route: 'row-side' },
                    corridorY: corridorY + offset
                }))));
    }

    function swapCrossingSharedPorts(plans) {
        for (let pass = 0; pass < 3; pass++) {
            let changed = false;
            for (let leftIndex = 0; leftIndex < plans.length; leftIndex++) {
                for (let rightIndex = leftIndex + 1; rightIndex < plans.length; rightIndex++) {
                    const left = plans[leftIndex];
                    const right = plans[rightIndex];
                    const beforeLeft = connectorGeometry(left);
                    const beforeRight = connectorGeometry(right);
                    if (!geometriesCross(beforeLeft, beforeRight)) continue;

                    const sharedDeparture = left.from === right.from
                        && left.sides.fromSide === right.sides.fromSide;
                    const sharedArrival = left.to === right.to
                        && left.sides.toSide === right.sides.toSide;
                    if (!sharedDeparture && !sharedArrival) continue;

                    if (sharedDeparture) {
                        [left.fromRate, right.fromRate] = [right.fromRate, left.fromRate];
                    } else {
                        [left.toRate, right.toRate] = [right.toRate, left.toRate];
                    }

                    if (geometriesCross(connectorGeometry(left), connectorGeometry(right))) {
                        if (sharedDeparture)
                            [left.fromRate, right.fromRate] = [right.fromRate, left.fromRate];
                        else
                            [left.toRate, right.toRate] = [right.toRate, left.toRate];
                    } else {
                        changed = true;
                    }
                }
            }
            if (!changed) break;
        }
    }

    function collisionFreeGeometry(plan, occupiedSegments) {
        const original = connectorGeometry(plan);
        if (!geometryCollides(plan, original, occupiedSegments)) return original;

        for (const candidate of rankedGeometryCandidates(plan, occupiedSegments, rowCorridorVariants(plan))) {
            if (!geometryCollides(plan, candidate.geometry, occupiedSegments)) return candidate.geometry;
        }

        for (const candidate of rankedGeometryCandidates(plan, occupiedSegments, rowCorridorToSideVariants(plan))) {
            if (!geometryCollides(plan, candidate.geometry, occupiedSegments)) return candidate.geometry;
        }

        for (let offset = 1; offset <= 8; offset++) {
            const shifted = connectorGeometry(plan, { offset });
            if (!geometryCollides(plan, shifted, occupiedSegments)) return shifted;
        }

        const oppositeGutter = connectorGeometry(plan, { sides: oppositeGutterSides(plan), offset: 1, fromRate: .5, toRate: .5 });
        if (!geometryCollides(plan, oppositeGutter, occupiedSegments)) return oppositeGutter;

        for (const candidate of rankedGeometryCandidates(plan, occupiedSegments, longWayAroundVariants(plan))) {
            if (!geometryCollides(plan, candidate.geometry, occupiedSegments)) return candidate.geometry;
        }

        const oppositeSide = side => ({ top: 'bottom', right: 'left', bottom: 'top', left: 'right' })[side];
        const orderedSides = preferred => [...new Set([
            preferred,
            oppositeSide(preferred),
            'bottom',
            'top',
            'right',
            'left'
        ])];
        const fromSides = orderedSides(plan.sides.fromSide);
        const toSides = orderedSides(plan.sides.toSide);
        const portRates = [.5, .28, .72];
        for (const fromSide of fromSides) {
            for (const toSide of toSides) {
                if (fromSide === plan.sides.fromSide && toSide === plan.sides.toSide) continue;
                const sides = { fromSide, toSide, route: 'reroute' };
                for (let offset = 0; offset <= 16; offset++) {
                    for (const rate of portRates) {
                        const candidate = connectorGeometry(plan, {
                            sides,
                            offset,
                            fromRate: fromSide === plan.sides.fromSide ? plan.fromRate : rate,
                            toRate: toSide === plan.sides.toSide ? plan.toRate : rate
                        });
                        if (!geometryCollides(plan, candidate, occupiedSegments)) return candidate;
                    }
                }
            }
        }

        return original;
    }

    function terminalCollisionFreeGeometry(plan, occupiedSegments) {
        const offsetVariants = Array.from({ length: 8 }, (_, index) => ({ offset: index + 1 }));
        const variants = [
            {},
            ...sideOptimisationVariants(plan),
            ...rowCorridorVariants(plan),
            ...rowCorridorToSideVariants(plan),
            ...offsetVariants,
            { sides: oppositeGutterSides(plan), offset: 1, fromRate: .5, toRate: .5 },
            { sides: oppositeGutterToNearestSide(plan), offset: 1, fromRate: .5, toRate: .5 },
            ...longWayAroundVariants(plan)
        ];

        return bestNonCollidingGeometry(plan, occupiedSegments, variants)
            ?? rankedGeometryCandidates(plan, occupiedSegments, variants)[0]?.geometry
            ?? connectorGeometry(plan);
    }

    function drawEdges() {
        svg.querySelectorAll('.workflow-connector, .workflow-connector-label').forEach(item => item.remove());
        const plans = [...document.querySelectorAll('.workflow-edge-data')].map((edge, index) => {
            const from = document.getElementById(edge.dataset.edgeFrom);
            const to = document.getElementById(edge.dataset.edgeTo);
            if (!from || !to) return null;
            const plan = {
                edge,
                from,
                to,
                index,
                kind: edge.dataset.edgeKind,
                track: Number(edge.dataset.edgeTrack || 0)
            };
            plan.sides = chooseConnectorSides(plan, from, to);
            return plan;
        }).filter(Boolean);

        const portGroups = new Map();
        plans.forEach(plan => {
            [['from', plan.from, plan.sides.fromSide, nodeCentre(plan.to)], ['to', plan.to, plan.sides.toSide, nodeCentre(plan.from)]].forEach(([endName, node, side, other]) => {
                const key = `${node.id}|${side}`;
                const group = portGroups.get(key) || [];
                group.push({ plan, endName, node, side, order: side === 'top' || side === 'bottom' ? other.x : other.y });
                portGroups.set(key, group);
            });
        });
        portGroups.forEach(group => {
            const first = group[0];
            const horizontalSide = first.side === 'top' || first.side === 'bottom';
            const axisLength = horizontalSide ? first.node.offsetWidth : first.node.offsetHeight;
            const axisStart = horizontalSide ? first.node.offsetLeft : first.node.offsetTop;
            const margin = Math.min(18, axisLength / 3);
            const spacing = 10;
            const centre = axisLength / 2;
            const used = [];
            const preferredCoordinate = port => {
                if (isStraightThroughRoute(port.plan)) return centre;
                return clamp(port.order - axisStart, margin, axisLength - margin);
            };
            const reserveCoordinate = coordinate => {
                const reserved = clamp(coordinate, margin, axisLength - margin);
                used.push(reserved);
                return reserved;
            };
            const coordinateIsFree = coordinate =>
                !used.some(existing => Math.abs(existing - coordinate) < spacing);
            const nearestCentreSlot = desired => {
                const direction = desired < centre ? -1 : 1;
                const slotCount = Math.ceil(axisLength / spacing);
                const preferredOffsets = [0];
                for (let step = 1; step <= slotCount; step++)
                    preferredOffsets.push(direction * step * spacing, direction * -step * spacing);

                for (const offset of preferredOffsets) {
                    const coordinate = clamp(centre + offset, margin, axisLength - margin);
                    if (coordinateIsFree(coordinate))
                        return reserveCoordinate(coordinate);
                }

                for (let step = 1; step <= slotCount; step++) {
                    for (const offset of [-step * spacing, step * spacing]) {
                        const coordinate = clamp(centre + offset, margin, axisLength - margin);
                        if (coordinateIsFree(coordinate))
                            return reserveCoordinate(coordinate);
                    }
                }

                return reserveCoordinate(centre);
            };

            const orderedPorts = group
                .map(port => ({ port, desired: preferredCoordinate(port) }))
                .sort((left, right) =>
                    Number(isStraightThroughRoute(right.port.plan)) - Number(isStraightThroughRoute(left.port.plan))
                    || Math.abs(left.desired - centre) - Math.abs(right.desired - centre)
                    || left.port.plan.index - right.port.plan.index);

            orderedPorts.forEach(({ port, desired }) => {
                port.plan[`${port.endName}Rate`] = nearestCentreSlot(desired) / axisLength;
            });
        });

        swapCrossingSharedPorts(plans);
        const routePriority = { default: 0, handoff: 1, terminal: 2, branch: 3 };
        plans.sort((left, right) =>
            (routePriority[left.kind] ?? 4) - (routePriority[right.kind] ?? 4)
            || (left.kind === 'terminal' && right.kind === 'terminal'
                ? left.to.offsetTop - right.to.offsetTop
                    || left.from.offsetTop - right.from.offsetTop
                    || left.to.offsetLeft - right.to.offsetLeft
                : 0)
            || left.index - right.index);
        const occupiedSegments = [];
        plans.forEach(plan => {
            const chosenGeometry = plan.kind === 'handoff'
                ? connectorGeometry(plan)
                : plan.kind === 'terminal'
                    ? terminalCollisionFreeGeometry(plan, occupiedSegments)
                : collisionFreeGeometry(plan, occupiedSegments);
            const geometry = plan.kind === 'handoff'
                ? chosenGeometry
                : optimiseConnectionSides(plan, occupiedSegments, chosenGeometry);
            const path = document.createElementNS(svgNamespace, 'path');
            path.setAttribute('d', geometry.d);
            path.setAttribute('class', `workflow-connector workflow-connector--${plan.kind}`);
            path.classList.toggle('is-dimmed', plan.from.classList.contains('is-dimmed'));
            path.dataset.edgeFrom = plan.edge.dataset.edgeFrom;
            path.dataset.edgeTo = plan.edge.dataset.edgeTo;
            path.setAttribute('marker-end', `url(#workflowArrow${plan.kind[0].toUpperCase()}${plan.kind.slice(1)})`);
            svg.appendChild(path);
            occupiedSegments.push(...connectorSegments(geometry.points).map(segment => ({
                ...segment,
                kind: plan.kind
            })));

            // Terminal cards already carry their outcome and destination. Repeating the
            // same text on the short incoming edge obscures the branch at fit-to-screen.
            if (plan.edge.dataset.edgeLabel && plan.kind !== 'default' && plan.kind !== 'terminal') {
                const label = document.createElementNS(svgNamespace, 'text');
                label.setAttribute('x', geometry.label.x);
                label.setAttribute('y', geometry.label.y);
                label.setAttribute('class', `workflow-connector-label workflow-connector-label--${plan.kind}`);
                label.classList.toggle('is-dimmed', plan.from.classList.contains('is-dimmed'));
                label.setAttribute('text-anchor', geometry.label.anchor);
                label.textContent = plan.edge.dataset.edgeLabel;
                svg.appendChild(label);
            }
        });
    }

    function showInspector(templateId, preserveScroll = false) {
        const template = document.getElementById(templateId);
        if (!template) return;
        const previousScrollTop = inspectorContent.scrollTop;
        activeTemplateId = templateId;
        inspectorHeading.textContent = template.dataset.heading || 'Workflow details';
        inspectorContext.textContent = template.dataset.context || 'Workflow';
        inspector.dataset.lane = template.dataset.lane || '';
        inspectorContent.replaceChildren(template.content.cloneNode(true));
        inspectorContent.scrollTop = preserveScroll ? previousScrollTop : 0;
        inspector.classList.add('is-open');
        document.querySelectorAll('.workflow-graph-node.is-selected').forEach(item => item.classList.remove('is-selected'));
        const selected = document.querySelector(`[data-inspector-template="${templateId}"]`);
        selected?.classList.add('is-selected');
    }

    document.addEventListener('click', event => {
        const drillDown = event.target.closest('[data-inspector-template]');
        if (drillDown) {
            showInspector(drillDown.dataset.inspectorTemplate);
            return;
        }
        if (event.target.closest('[data-inspector-close]')) {
            inspector.classList.remove('is-open');
            activeTemplateId = null;
            document.querySelectorAll('.workflow-graph-node.is-selected').forEach(item => item.classList.remove('is-selected'));
        }
    });

    document.querySelectorAll('[data-workflow-zoom]').forEach(button => button.addEventListener('click', () => {
        setScale(scale + (button.dataset.workflowZoom === 'in' ? .1 : -.1));
    }));
    document.querySelector('[data-workflow-fit]').addEventListener('click', fitSurface);

    document.querySelectorAll('[data-focus-lane]').forEach(button => button.addEventListener('click', () => {
        document.querySelectorAll('[data-focus-lane]').forEach(item => item.classList.toggle('is-active', item === button));
        const laneId = button.dataset.focusLane;
        document.querySelectorAll('[data-lane-id]').forEach(lane => lane.classList.toggle('is-dimmed', laneId !== 'all' && lane.dataset.laneId !== laneId));
        document.querySelectorAll('.workflow-graph-node').forEach(node => {
            const top = node.offsetTop;
            const matchingLane = [...document.querySelectorAll('[data-lane-id]')].find(item => top >= item.offsetTop && top <= item.offsetTop + item.offsetHeight);
            node.classList.toggle('is-dimmed', laneId !== 'all' && matchingLane?.dataset.laneId !== laneId);
        });
        drawEdges();
        if (laneId === 'all') {
            fitSurface();
            return;
        }
        const lane = document.querySelector(`[data-lane-id="${laneId}"]`);
        if (lane) {
            setScale(Math.min(.95, (viewport.clientWidth - 24) / stageWidth), false);
            viewport.scrollTo({ left: 0, top: Math.max(0, lane.offsetTop * scale - 16) });
        }
    }));

    viewport.addEventListener('pointerdown', event => {
        if (event.target.closest('button, summary, a')) return;
        dragging = true;
        dragStart = { x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
        viewport.setPointerCapture(event.pointerId);
        viewport.classList.add('is-panning');
    });
    viewport.addEventListener('pointermove', event => {
        if (!dragging) return;
        viewport.scrollLeft = dragStart.left - (event.clientX - dragStart.x);
        viewport.scrollTop = dragStart.top - (event.clientY - dragStart.y);
    });
    viewport.addEventListener('pointerup', event => {
        dragging = false;
        viewport.releasePointerCapture(event.pointerId);
        viewport.classList.remove('is-panning');
    });

    const resizeObserver = new ResizeObserver(() => {
        positionScaledStage();
        drawEdges();
    });
    resizeObserver.observe(stage);

    async function refreshLiveState() {
        if (!refreshToggle.checked || document.hidden || refreshInProgress) return;
        refreshInProgress = true;
        refreshStatus.textContent = 'Checking…';
        try {
            const response = await fetch(window.location.href, {
                cache: 'no-store',
                headers: { Accept: 'text/html', 'X-Workflow-Refresh': 'live-counts' }
            });
            if (!response.ok) throw new Error(`Refresh returned ${response.status}`);
            const freshDocument = new DOMParser().parseFromString(await response.text(), 'text/html');

            freshDocument.querySelectorAll('[data-live-key]').forEach(source => {
                const key = source.dataset.liveKey;
                const target = document.querySelector(`[data-live-key="${CSS.escape(key)}"]`);
                if (!target) return;
                target.className = source.className;
                target.replaceChildren(...[...source.childNodes].map(node => node.cloneNode(true)));
            });

            freshDocument.querySelectorAll('template[data-live-template]').forEach(source => {
                const target = document.getElementById(source.id);
                if (!target) return;
                target.innerHTML = source.innerHTML;
            });

            if (activeTemplateId && inspector.classList.contains('is-open'))
                showInspector(activeTemplateId, true);

            const generated = freshDocument.querySelector('[data-live-key="generated-at"]');
            const time = generated?.textContent.match(/\d{2}:\d{2}:\d{2}/)?.[0];
            refreshStatus.textContent = `Updated ${time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        } catch (error) {
            refreshStatus.textContent = 'Refresh failed · retrying';
        } finally {
            refreshInProgress = false;
        }
    }

    const refreshPreferenceKey = 'crm.workflow.auto-refresh';
    refreshToggle.checked = localStorage.getItem(refreshPreferenceKey) !== 'off';
    refreshToggle.addEventListener('change', () => {
        localStorage.setItem(refreshPreferenceKey, refreshToggle.checked ? 'on' : 'off');
        refreshStatus.textContent = refreshToggle.checked ? 'Refresh enabled' : 'Refresh paused';
        if (refreshToggle.checked) refreshLiveState();
    });
    window.setInterval(refreshLiveState, 10000);

    requestAnimationFrame(() => {
        drawEdges();
        fitSurface();
    });
})();
</script>
